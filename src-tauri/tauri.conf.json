{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salary Garden",
  "version": "0.1.0",
  "identifier": "com.salarygarden.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Salary Garden",
        "width": 960,
        "height": 540,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}

